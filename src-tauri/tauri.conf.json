{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scratch",
  "version": "0.1.0",
  "identifier": "com.scratch.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 420,
        "height": 520,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "transparent": false,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "center": false,
        "decorations": true,
        "visible": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A minimal markdown scratchpad with GitHub PR linking and sync",
    "longDescription": "Scratch is a minimal markdown scratchpad with sticky notes, GitHub PR linking and automatic sync.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
